# MedCore 302 Backend Environment Configuration

# Port to listen on (default: 3000)
PORT=3000

# Allowed CORS origins (e.g. http://localhost:5173 or * for development)
CORS_ORIGIN=*

# Path to SQLite database file
# For local development: ./medcore.sqlite
# For cloud deployments with persistent volumes (e.g. Render): /etc/data/medcore.sqlite
DB_PATH=./medcore.sqlite

